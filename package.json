{
  "name": "dsh-system-monitor",
  "version": "0.2.3",
  "description": "System monitor plugin for the DeepSeek Harness web GUI: a right-sidebar \"System\" panel with live CPU (per-core + frequency), memory/swap, GPU (utilization, VRAM, temperature, power, processes) and temperature/fan/power telemetry.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MUHAN11-c/dsh-system-monitor.git"
  },
  "homepage": "https://github.com/MUHAN11-c/dsh-system-monitor#readme",
  "bugs": {
    "url": "https://github.com/MUHAN11-c/dsh-system-monitor/issues"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "system-monitor",
    "nvtop",
    "htop",
    "gpu",
    "web-ui"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  }
}
